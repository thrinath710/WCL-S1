# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
# Project Settings -> API. Without these the site renders its empty states.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Project Settings -> API -> service_role. SERVER ONLY -- never prefix with
# NEXT_PUBLIC_. This key bypasses row level security and is what the admin
# Server Actions use to write, after checking the signed-in email below.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Admin
# ---------------------------------------------------------------------------
# The organiser: full control of /admin. Comma separated if you add a
# co-organiser. An account on neither list can sign in to Supabase and still
# do nothing at all.
ADMIN_EMAILS=you@example.com

# Match hosts: whoever runs the evening. They can enter and edit results,
# change kickoff times, courts and the two sides of a fixture, and drive the
# knockout draw. They cannot touch squads, team names or these settings, and
# cannot add or delete fixtures.
#
# An address on both lists is treated as an organiser -- the stronger role
# wins, so putting yourself here by mistake cannot lock you out.
HOST_EMAILS=host@wcl.local

# ---------------------------------------------------------------------------
# Display
# ---------------------------------------------------------------------------
# Kickoff times mean the campus clock, not the reader's. Pinning the zone also
# keeps server and browser rendering identical.
NEXT_PUBLIC_TIMEZONE=Asia/Kolkata

# Used for absolute URLs in link previews. Vercel fills this in automatically.
NEXT_PUBLIC_SITE_URL=


# Optional. Pre-fills the sign-in email so you only type a password. The field
# stays editable, so a match host can still sign in with their own address.
# Leaving it blank is safer: setting it publishes which address can sign in.
NEXT_PUBLIC_ADMIN_EMAIL=
